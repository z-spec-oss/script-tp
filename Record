function _G.AETHERHUB.SaveTrack(NamaFile)
    if #DataRekaman < 2 then Notify("SAVE ERROR", "Tidak ada data gerakan untuk disimpan!", "Gagal") return end
    if not writefile then Notify("EXECUTOR ERROR", "Executor kamu tidak mendukung writefile!", "Gagal") return end

    local DataSiapSimpan = { Tracks = {}, SafePoints = TitikAman, DurasiTotal = WaktuAkumulasi }
    for _, frame in ipairs(DataRekaman) do
        table.insert(DataSiapSimpan.Tracks, {
            Posisi = {frame.Posisi.X, frame.Posisi.Y, frame.Posisi.Z},
            Rotasi = {frame.Rotasi:ToEulerAnglesXYZ()},
            Kecepatan = {frame.Kecepatan.X, frame.Kecepatan.Y, frame.Kecepatan.Z},
            Lompat = frame.Lompat,
            Tinggi = frame.Tinggi,
            Waktu = frame.Waktu
        })
    end

    local Sukses, HasilJSON = pcall(function() return HttpService:JSONEncode(DataSiapSimpan) end)
    if Sukses then
        writefile("AETHERHUB_TRACKS/".. NamaFile.. ".txt", HasilJSON)
        Notify("SAVE SUCCESS", "Rute '".. NamaFile.. "' berhasil disimpan!", "Sukses")
    else
        Notify("SAVE ERROR", "Gagal melakukan enkripsi data!", "Gagal")
    end
end

function _G.AETHERHUB.LoadTrack(NamaFile)
    if not readfile or not isfile then Notify("EXECUTOR ERROR", "Executor kamu tidak mendukung berkas teks!", "Gagal") return end
    local JalurBerkas = "AETHERHUB_TRACKS/".. NamaFile.. ".txt"
    if not isfile(JalurBerkas) then Notify("LOAD ERROR", "Berkas '".. NamaFile.. "' tidak ditemukan!", "Gagal") return end

    local KontenMentah = readfile(JalurBerkas)
    local Sukses, DataTerbuka = pcall(function() return HttpService:JSONDecode(KontenMentah) end)

    if Sukses and DataTerbuka then
        DataRekaman = {}
        TitikAman = DataTerbuka.SafePoints or {}
        WaktuAkumulasi = DataTerbuka.DurasiTotal or 0

        for _, frame in ipairs(DataTerbuka.Tracks) do
            table.insert(DataRekaman, {
                Posisi = Vector3.new(frame.Posisi[1], frame.Posisi[2], frame.Posisi[3]),
                Rotasi = CFrame.fromEulerAnglesXYZ(frame.Rotasi[1], frame.Rotasi[2], frame.Rotasi[3]),
                Kecepatan = Vector3.new(frame.Kecepatan[1], frame.Kecepatan[2], frame.Kecepatan[3]),
                Lompat = frame.Lompat,
                Tinggi = frame.Tinggi,
                Waktu = frame.Waktu
            })
        end
        Notify("LOAD SUCCESS", "Rute '".. NamaFile.. "' berhasil dimuat! (".. #DataRekaman.. " Titik)", "Sukses")
    else
        Notify("LOAD ERROR", "Format berkas rusak atau korup!", "Gagal")
    end
end

function _G.AETHERHUB.DeleteTrack(NamaFile)
    if not delfile or not isfile then Notify("EXECUTOR ERROR", "Executor tidak mendukung penghapusan!", "Gagal") return end
    local JalurBerkas = "AETHERHUB_TRACKS/".. NamaFile.. ".txt"
    if isfile(JalurBerkas) then
        delfile(JalurBerkas)
        Notify("DELETE SUCCESS", "Berkas '".. NamaFile.. "' dihapus permanen!", "Sukses")
    else
        Notify("DELETE ERROR", "Berkas tidak ditemukan!", "Gagal")
    end
end

-- ROLLBACK
function _G.AETHERHUB.EksekusiRollback()
    if not SedangMerekam then Notify("ROLLBACK", "Harus dalam kondisi merekam!", "Gagal") return end
    if #TitikAman == 0 then Notify("ROLLBACK", "Tidak ada posisi aman obby tersimpan!", "Gagal") return end

    local IndeksAmanTerakhir = table.remove(TitikAman)
    local DataAman = DataRekaman[IndeksAmanTerakhir]
    if not DataAman then return end

    for i = #DataRekaman, IndeksAmanTerakhir + 1, -1 do
        table.remove(DataRekaman, i)
    end

    RootPart.CFrame = CFrame.new(DataAman.Posisi) * DataAman.Rotasi
    RootPart.AssemblyLinearVelocity = Vector3.zero
    WaktuAkumulasi = DataAman.Waktu
    if TextTimerWidget then TextTimerWidget.Text = FormatWaktu(WaktuAkumulasi) end

    TerakhirPosRecord = DataAman.Posisi
    TerakhirPosAman = DataAman.Posisi
    Notify("ROLLBACK", "Mundur ke platform aman obby! Sisa: ".. #TitikAman, "Sukses")
end

