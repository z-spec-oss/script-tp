LocalPlayer.CharacterAdded:Connect(MuatKarakter)

local function Notify(Judul, Pesan, Tipe)
    WindUI:Notify({
        Title = "AETHERHUB • ".. Judul,
        Content = Pesan,
        Type = (Tipe == "Sukses") and "Success" or "Information",
        Timeout = 3
    })
end

local function FormatWaktu(TotalDetik)
    local Menit = math.floor(TotalDetik / 60)
    local Detik = math.floor(TotalDetik % 60)
    return string.format("%02d:%02d", Menit, Detik)
end

local function CekPijakanAmanObby()
    if not RootPart or not Humanoid then return false end
    local State = Humanoid:GetState()
    if State == Enum.HumanoidStateType.Jumping or State == Enum.HumanoidStateType.Freefall or State == Enum.HumanoidStateType.Dead then
        return false
    end
    local RaycastPar = RaycastParams.new()
    RaycastPar.FilterType = Enum.RaycastFilterType.Exclude
    RaycastPar.FilterDescendantsInstances = {Character}
    local HasilRay = workspace:Raycast(RootPart.Position, Vector3.new(0, -3.6, 0), RaycastPar)
    if HasilRay and HasilRay.Instance then
        if HasilRay.Instance.CanCollide == false or HasilRay.Instance.Transparency > 0.9 then
            return false
        end
        return true
    end
    return false
end

