-- REKAM
function _G.AETHERHUB.MulaiRekam()
    if SedangMerekam then return end
    SedangMerekam = true
    DataRekaman = {}
    TitikAman = {}
    WaktuAkumulasi = 0
    WaktuTerakhirAman = tick()
    if RootPart then TerakhirPosRecord = RootPart.Position TerakhirPosAman = RootPart.Position end
    BuatFloatingWidget()

    Koneksi = RunService.Heartbeat:Connect(function(DeltaT)
        if not RootPart or not SedangMerekam then return end
        local PosisiSekarang = RootPart.Position
        local JarakGerak = (PosisiSekarang - TerakhirPosRecord).Magnitude
        if JarakGerak >= _G.AETHERHUB.Settings.JarakMinimalRecord then
            WaktuAkumulasi = WaktuAkumulasi + DeltaT
            if TextTimerWidget then TextTimerWidget.Text = FormatWaktu(WaktuAkumulasi) end
            table.insert(DataRekaman, {
                Posisi = PosisiSekarang,
                Rotasi = RootPart.CFrame - PosisiSekarang,
                Kecepatan = RootPart.AssemblyLinearVelocity,
                Lompat = Humanoid.Jump,
                Tinggi = PosisiSekarang.Y,
                Waktu = WaktuAkumulasi
            })
            local IndeksSekarang = #DataRekaman
            TerakhirPosRecord = PosisiSekarang
            if CekPijakanAmanObby() then
                local JarakDariAmanLama = (PosisiSekarang - TerakhirPosAman).Magnitude
                local WaktuSekarang = tick()
                if JarakDariAmanLama >= 4 and (WaktuSekarang - WaktuTerakhirAman) >= _G.AETHERHUB.Settings.JedaTitikAman then
                    table.insert(TitikAman, IndeksSekarang)
                    TerakhirPosAman = PosisiSekarang
                    WaktuTerakhirAman = WaktuSekarang
                end
            end
        end
    end)
    Notify("REKAM", "Perekaman obby dimulai...", "Sukses")
end

function _G.AETHERHUB.HentikanRekam()
    if not SedangMerekam then return end
    SedangMerekam = false
    if Koneksi then Koneksi:Disconnect() end
    HancurkanFloatingWidget()
    Notify("REKAM", "Berhenti! Total: ".. #DataRekaman.. " titik", "Sukses")
end

-- PLAYBACK
function _G.AETHERHUB.MulaiPutar(Ulang)
    if #DataRekaman < 2 then Notify("ERROR", "Belum ada rekaman!", "Gagal") return end
    if SedangMemutar then _G.AETHERHUB.HentikanPutar() return end
    SedangMemutar = true
    SedangMengulang = Ulang or false
    IndeksBingkai = 1
    local WaktuMulai = tick()
    local TotalData = #DataRekaman
    local HalusPos = RootPart.Position
    local HalusRot = RootPart.CFrame - RootPart.Position
    Notify(Ulang and "LOOP" or "PUTAR", "Dimulai...", "Sukses")

    Koneksi = RunService.Heartbeat:Connect(function()
        if not SedangMemutar or not RootPart then _G.AETHERHUB.HentikanPutar() return end
        local WaktuSekarang = (tick() - WaktuMulai) * _G.AETHERHUB.Settings.SpeedMultiplier
        while IndeksBingkai < TotalData and DataRekaman[IndeksBingkai + 1].Waktu <= WaktuSekarang do IndeksBingkai = IndeksBingkai + 1 end
        if IndeksBingkai >= TotalData then
            if SedangMengulang then IndeksBingkai = 1 WaktuMulai = tick() return else _G.AETHERHUB.HentikanPutar() return end
        end
        local Data1 = DataRekaman[IndeksBingkai]
        local Data2 = DataRekaman[IndeksBingkai + 1]
        local JarakWaktu = Data2.Waktu - Data1.Waktu
        local Progresi = JarakWaktu > 0 and math.clamp((WaktuSekarang - Data1.Waktu) / JarakWaktu, 0, 1) or 0
        local TargetXZ = Data1.Posisi:Lerp(Data2.Posisi, Progresi)

-- PILIH Y: pakai rekaman atau pakai tinggi asli
local TargetY
if _G.AETHERHUB.Settings.UseRecordedHeight then
    TargetY = Data1.Tinggi + (Data2.Tinggi - Data1.Tinggi) * Progresi
else
    TargetY = RootPart.Position.Y  -- biarin gravitasi yang kerja
end

local TargetPos = Vector3.new(TargetXZ.X, TargetY, TargetXZ.Z)
        local TargetRot = Data1.Rotasi:Lerp(Data2.Rotasi, Progresi * _G.AETHERHUB.Settings.RotationSmooth)
        HalusPos = HalusPos:Lerp(TargetPos, _G.AETHERHUB.Settings.Smoothness)
        HalusRot = HalusRot:Lerp(TargetRot, _G.AETHERHUB.Settings.Smoothness)
        local Jarak = (RootPart.Position - HalusPos).Magnitude
        if Jarak > _G.AETHERHUB.Settings.TeleportThreshold then
            RootPart.CFrame = CFrame.new(TargetPos) * TargetRot
            HalusPos = TargetPos HalusRot = TargetRot
        else
            Humanoid:MoveTo(HalusPos)
            RootPart.CFrame = CFrame.new(HalusPos) * HalusRot
      
if _G.AETHERHUB.Settings.UseRecordedHeight then
    RootPart.AssemblyLinearVelocity = Data1.Kecepatan:Lerp(Data2.Kecepatan, Progresi)
else
    -- hanya ikutin kecepatan XZ, Y biarin fisika
    local vel = Data1.Kecepatan:Lerp(Data2.Kecepatan, Progresi)
    RootPart.AssemblyLinearVelocity = Vector3.new(vel.X, RootPart.AssemblyLinearVelocity.Y, vel.Z)
end
        end
        if Data1.Lompat or Data2.Lompat then Humanoid.Jump = true end
    end)

function _G.AETHERHUB.HentikanPutar()
    if not SedangMemutar then return end
    SedangMemutar = false SedangMengulang = false
    if Koneksi then Koneksi:Disconnect() end
    Notify("BERHENTI", "Gerakan dihentikan", "Sukses")
end

function _G.AETHERHUB:Destroy()
    if _G.AETHERHUB.HentikanPutar then _G.AETHERHUB.HentikanPutar() end
    if _G.AETHERHUB.HentikanRekam then _G.AETHERHUB.HentikanRekam() end
    HancurkanFloatingWidget()
    Window:Close()
end

